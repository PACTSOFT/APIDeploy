FROM INV_DocDetails INV with(nolock) inner join COM_DocCCData DCC with(nolock) on DCC.InvDocDetailsID=INV.InvDocDetailsID
inner join ACC_Accounts A with(nolock) on A.AccountID=INV.CreditAccount
inner join ACC_AccountsExtended AEXT with(nolock) on AEXT.AccountID=A.AccountID
inner join INV_Product P with(nolock) on P.ProductID=INV.ProductID
inner join COM_DocNumData NUM with(nolock) on NUM.InvDocDetailsID=INV.InvDocDetailsID
inner join COM_DocTextData TXT with(nolock) on TXT.InvDocDetailsID=INV.InvDocDetailsID
inner join COM_Currency CUR with(nolock) on CUR.CurrencyID=INV.CurrencyID
WHERE INV.CostCenterID=41021 and INV.StatusID=369 and (INV.DynamicInvDocDetailsID is null or INV.DynamicInvDocDetailsID=0) and INV.DocDate between convert(float,convert(datetime,''01 Jul 2026'')) and convert(float,convert(datetime,''31 Jul 2026''))
UNION ALL
SELECT A.AccountName,AEXT.acAlpha51,convert(datetime,INV.DocDate),INV.VoucherNo,INV.DocAbbr,INV.DocPrefix,CONVERT(BIGINT,INV.DocNumber),NULL,INV.DocSeqNo,P.ProductName,NUM.dcCalcNum51,NUM.dcCalcNum61,TXT.dcAlpha152,CUR.Symbol,0.0,0.0
FROM INV_DocDetails INV with(nolock) inner join COM_DocCCData DCC with(nolock) on DCC.InvDocDetailsID=INV.InvDocDetailsID
inner join ACC_Accounts A with(nolock) on A.AccountID=INV.CreditAccount
