[System: 192.168.1.99] DEBUG | 07/02/2026 16:23:36.289 | General Service|:: CompanyIndex:326 SpName: spADM_GetDataSet 
 'DECLARE @From FLOAT,@To FLOAT
SET @From=CONVERT(FLOAT,CONVERT(DATETIME,''01 Jan 2026''))
SET @To=CONVERT(FLOAT,CONVERT(DATETIME,''02 Jul 2026''))

SELECT A.AccountCode,A.AccountName,ACC.Balance,ACC.OpDocBalance,A.AccountID,A.IsGroup,A.lft,A.rgt,A.AccountTypeID,A.Depth,A.BS IsSummary
FROM (
SELECT T1.AccountID,SUM(OP_Dr)+SUM(TR_Dr)-(SUM(OP_Cr)+SUM(TR_Cr)) Balance,SUM(OpDocDr)-SUM(OpDocCr) OpDocBalance

FROM (
--Opening Dr
SELECT ACC.DebitAccount AccountID,ACC.VoucherNo,ACC.Amount OP_Dr,0 OP_Cr,0 TR_Dr,0 TR_Cr,case when ACC.DocumentType=16 then ACC.Amount else 0 end OpDocDr,0 OpDocCr

FROM ACC_DocDetails ACC WITH(NOLOCK)
WHERE (ACC.DocDate<@From OR (ACC.DocumentType=16 AND (ACC.StatusID=369 or ACC.StatusID=429)))  AND ACC.DocumentType<>14 AND ACC.DocumentType<>19 AND (ACC.StatusID=369 or ACC.StatusID=429)
UNION ALL--Opening Cr
SELECT ACC.CreditAccount AccountID,ACC.VoucherNo,0 OP_Dr,ACC.Amount OP_Cr,0 TR_Dr, 0 TR_Cr,0 OpDocDr,case when ACC.DocumentType=16 then ACC.Amount else 0 end OpDocCr 
FROM ACC_DocDetails ACC WITH(NOLOCK)
WHERE (ACC.DocDate<@From OR (ACC.DocumentType=16 AND (ACC.StatusID=369 or ACC.StatusID=429)))   AND ACC.DocumentType<>14 AND ACC.DocumentType<>19 AND (ACC.StatusID=369 or ACC.StatusID=429)
UNION ALL--Transaction Dr
SELECT ACC.DebitAccount AccountID,ACC.VoucherNo,0 OP_Dr,0 OP_Cr,ACC.Amount TR_Dr,0 TR_Cr,0 OpDocDr,0 OpDocCr
FROM ACC_DocDetails ACC WITH(NOLOCK)
WHERE (ACC.DocDate BETWEEN @From AND @To) AND ACC.DocumentType NOT IN (16,14,19) AND (ACC.StatusID=369 or ACC.StatusID=429)
UNION ALL--Transaction Cr
SELECT ACC.CreditAccount AccountID,ACC.VoucherNo,0 OP_Dr,0 OP_Cr,0 TR_Dr,ACC.Amount TR_Cr,0 OpDocDr,0 OpDocCr
FROM ACC_DocDetails ACC  WITH(NOLOCK)
WHERE (ACC.DocDate BETWEEN @From AND @To) AND ACC.DocumentType NOT IN (16,14,19) AND (ACC.StatusID=369 or ACC.StatusID=429)) AS T1  GROUP BY T1.AccountID
) AS ACC RIGHT JOIN ACC_Accounts A WITH(NOLOCK) ON A.AccountID=ACC.AccountID
WHERE A.AccountID>1 AND A.AccountTypeID IN (1,2,7,10,13,15,3,6,14,16) Order By lft'
