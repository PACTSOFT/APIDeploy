inner join COM_Currency CUR with(nolock) on CUR.CurrencyID=INV.CurrencyID
WHERE INV.CostCenterID=41000 and INV.StatusID=369 and (INV.DynamicInvDocDetailsID is null or INV.DynamicInvDocDetailsID=0) and INV.DocDate between convert(float,convert(datetime,''01 Jul 2026'')) and convert(float,convert(datetime,''31 Jul 2026''))
