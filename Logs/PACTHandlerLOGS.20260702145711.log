cSeqNo=B.DocSeqNo   WHERE B.IsNewReference=0 AND B.RefDocDate>@AsOnDate AND BCB.AccountID is null AND B.DocDate<=@AsOnDate AND ((SELECT top(1) 1 FROM ACC_DocDetails ACC WITH(NOLOCK) WHERE ACC.VoucherNo=B.DocNo and (StatusID=370 OR StatusID=439 OR StatusID=452))=1 OR (B.DocType<>14 AND B.DocType<>19 AND (SELECT top(1) 1 FROM ACC_DocDetails ACC WITH(NOLOCK) WHERE ACC.VoucherNo=B.DocNo and (StatusID=369 or StatusID=429))=1)) ) AS T WHERE AdjAmount!=0'
