,sum(StdAdjustment) StdAdjustment,sum(RCMAdjustment) RCMAdjustment from
(SELECT inv.voucherno Description,NUM.dcCalcNum51 TaxableValue
,NUM.dcCalcNum53 VATStdAmt,NUM.dcCalcNum55 VATRCMAmt,NUM.dcCalcNum57 VATCustomAmt,NUM.dcCalcNum59 VATAdvAmt
,0.0 StdAdjustment,0.0 RCMAdjustment
,DCC.dcCCNID59 VATState
FROM INV_DocDetails INV with(nolock) inner join COM_DocCCData DCC with(nolock) on DCC.InvDocDetailsID=INV.InvDocDetailsID
inner join COM_DocNumData NUM with(nolock) on NUM.InvDocDetailsID=INV.InvDocDetailsID
WHERE INV.CostCenterID in (41010,41024,40994,40011,41004,41003) and INV.StatusID=369 and (INV.DynamicInvDocDetailsID is null or INV.DynamicInvDocDetailsID=0)
and INV.DocDate between @From and @To
and DCC.dcCCNID62!=8 and DCC.dcCCNID61!=13 and DCC.dcCCNID61!=14 and NUM.dcCalcNum53 is not null and (NUM.dcCalcNum53!=0 or NUM.dcCalcNum55!=0) 
UNION ALL
SELECT inv.voucherno Description,-NUM.dcCalcNum51 TaxableValue
,-NUM.dcCalcNum53 VATStdAmt,-NUM.dcCalcNum55 VATRCMAmt,-NUM.dcCalcNum57 VATCustomAmt,-NUM.dcCalcNum59 VATAdvAmt
,0.0 StdAdjustment,0.0 RCMAdjustment
,DCC.dcCCNID59 VATState
FROM INV_DocDetails INV with(nolock) inner join COM_DocCCData DCC with(nolock) on DCC.InvDocDetailsID=INV.InvDocDetailsID
inner join COM_DocNumData NUM with(nolock) on NUM.InvDocDetailsID=INV.InvDocDetailsID
WHERE INV.CostCenterID in (40006,41005) and INV.StatusID=369 and (INV.DynamicInvDocDetailsID is null or INV.DynamicInvDocDetailsID=0)
and INV.DocDate between @From and @To
and DCC.dcCCNID62!=8 and DCC.dcCCNID61!=13 and DCC.dcCCNID61!=14 and (NUM.dcCalcNum53>0 or NUM.dcCalcNum55>0) ) AS T
group by VATState
--Zero,Exemp,OtherGCC
SELECT DCC.dcCCNID61 SaleType,DCC.dcCCNID62 AccType,sum(-INV.VoucherType*NUM.dcCalcNum51) TaxableValue
FROM INV_DocDetails INV with(nolock) inner join COM_DocCCData DCC with(nolock) on DCC.InvDocDetailsID=INV.InvDocDetailsID
inner join COM_DocNumData NUM with(nolock) on NUM.InvDocDetailsID=INV.InvDocDetailsID
WHERE INV.CostCenterID in (41010,41024,40994,40011,41004,41003,40006,41005) and INV.StatusID=369 and (INV.DynamicInvDocDetailsID is null or INV.DynamicInvDocDetailsID=0)
and INV.DocDate between @From and @To
and (DCC.dcCCNID61=13 or DCC.dcCCNID61=14 or DCC.dcCCNID62=8) GROUP BY DCC.dcCCNID61,DCC.dcCCNID62
--Customs
SELECT isnull(sum(NUM.dcCalcNum51),0) TaxableValue,isnull(sum(NUM.dcCalcNum57),0) VATCustomAmt
FROM INV_DocDetails INV with(nolock) inner join COM_DocCCData DCC with(nolock) on DCC.InvDocDetailsID=INV.InvDocDetailsID
inner join COM_DocNumData NUM with(nolock) on NUM.InvDocDetailsID=INV.InvDocDetailsID
join COM_CCCCDATA PCC with(nolock) on PCC.CostCenterID=3 and PCC.NodeID=INV.ProductID
WHERE INV.CostCenterID in (41011,41021,40001,41000) and INV.StatusID=369 and (INV.DynamicInvDocDetailsID is null or INV.DynamicInvDocDetailsID=0)
and INV.DocDate between @From and @To and (NUM.dcCalcNum57>0 )
and PCC.CCNID71=1 and DCC.dcCCNID62>=5 and DCC.dcCCNID62<=8
select VATStd,VATRCM,sum(TaxableValue) TaxableValue,sum(VATStdAmt) VATStdAmt,sum(VATRCMAmt) VATRCMAmt
,sum(StdAdjustment) StdAdjustment,sum(RCMAdjustment) RCMAdjustment,ProductType
from
(SELECT inv.voucherno Description,NUM.dcCalcNum51 TaxableValue,NUM.dcNum52 VATStd,NUM.dcCalcNum53 VATStdAmt,NUM.dcNum54 VATRCM,NUM.dcCalcNum55 VATRCMAmt
,0.0 StdAdjustment,0.0 RCMAdjustment,PCC.CCNID71 ProductType
FROM INV_DocDetails INV with(nolock) inner join COM_DocCCData DCC with(nolock) on DCC.InvDocDetailsID=INV.InvDocDetailsID
inner join COM_DocNumData NUM with(nolock) on NUM.InvDocDetailsID=INV.InvDocDetailsID
join COM_CCCCDATA PCC with(nolock) on PCC.CostCenterID=3 and PCC.NodeID=INV.ProductID
WHERE INV.CostCenterID in (41011,41021,40001,41000) and INV.StatusID=369 and (INV.DynamicInvDocDetailsID is null or INV.DynamicInvDocDetailsID=0)
and INV.DocDate between @From and @To
and (NUM.dcCalcNum53!=0 or NUM.dcCalcNum55!=0) 
UNION ALL
SELECT inv.voucherno Description,-NUM.dcCalcNum51 TaxableValue,NUM.dcNum52 VATStd,-NUM.dcCalcNum53 VATStdAmt,NUM.dcNum54 VATRCM,-NUM.dcCalcNum55 VATRCMAmt
,0.0 StdAdjustment,0.0 RCMAdjustment,PCC.CCNID71
FROM INV_DocDetails INV with(nolock) inner join COM_DocCCData DCC with(nolock) on DCC.InvDocDetailsID=INV.InvDocDetailsID
inner join COM_DocNumData NUM with(nolock) on NUM.InvDocDetailsID=INV.InvDocDetailsID
join COM_CCCCDATA PCC with(nolock) on PCC.CostCenterID=3 and PCC.NodeID=INV.ProductID
left join INV_DocDetails LINV with(nolock) on INV.LinkedInvDocDetailsID=LINV.InvDocDetailsID
WHERE INV.CostCenterID in (40010) and INV.StatusID=369 and (INV.DynamicInvDocDetailsID is null or INV.DynamicInvDocDetailsID=0)
and INV.DocDate between @From and @To and (LINV.DocDate is null or LINV.DocDate between @From and @To)
and (NUM.dcCalcNum53!=0 or NUM.dcCalcNum55!=0) 
UNION ALL
SELECT inv.voucherno Description,-NUM.dcCalcNum51 TaxableValue,NUM.dcNum52 VATStd,0.0 VATStdAmt,NUM.dcNum54 VATRCM,0.0 VATRCMAmt
,-NUM.dcCalcNum53 StdAdjustment,-NUM.dcCalcNum55 RCMAdjustment,PCC.CCNID71
FROM INV_DocDetails INV with(nolock) inner join COM_DocCCData DCC with(nolock) on DCC.InvDocDetailsID=INV.InvDocDetailsID
inner join COM_DocNumData NUM with(nolock) on NUM.InvDocDetailsID=INV.InvDocDetailsID
join COM_CCCCDATA PCC with(nolock) on PCC.CostCenterID=3 and PCC.NodeID=INV.ProductID
inner join INV_DocDetails LINV with(nolock) on INV.LinkedInvDocDetailsID=LINV.InvDocDetailsID
WHERE INV.CostCenterID in (40010) and INV.StatusID=369 and (INV.DynamicInvDocDetailsID is null or INV.DynamicInvDocDetailsID=0)
and INV.DocDate between @From and @To and LINV.DocDate<@From
and (NUM.dcCalcNum53!=0 or NUM.dcCalcNum55!=0) ) AS T
group by VATStd,VATRCM,ProductType
select -sum(TaxableValue) TaxableValue,-sum(VATStdAmt) VATStdAmt
from
(SELECT inv.voucherno Description,NUM.dcCalcNum51 TaxableValue,NUM.dcCalcNum53 VATStdAmt
FROM INV_DocDetails INV with(nolock) inner join COM_DocCCData DCC with(nolock) on DCC.InvDocDetailsID=INV.InvDocDetailsID
inner join COM_DocNumData NUM with(nolock) on NUM.InvDocDetailsID=INV.InvDocDetailsID
WHERE INV.CostCenterID in (41011,41021,40001,41000) and INV.StatusID=369 and (INV.DynamicInvDocDetailsID is null or INV.DynamicInvDocDetailsID=0)
and INV.DocDate between @From and @To
and NUM.dcCalcNum53 is not null and NUM.dcCalcNum53!=0 ) AS T
select 0 NoCustomAdj where 1!=1'
