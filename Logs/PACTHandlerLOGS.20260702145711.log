t BillAmount,CONVERT(DATETIME,B.DocDate) DocDate,CONVERT(DATETIME,B.DocDueDate) DueDate,B.AdjAmount AdjAmount,@AsOn-B.DocDate OverDue,ISNULL((SELECT SUM(CB.AdjAmount) FROM COM_Billwise CB WITH(NOLOCK) WHERE CB.RefDocNo=B.DocNo AND CB.AccountID=B.AccountID AND CB.RefDocSeqNo=B.DocSeqNo AND IsNewReference=0 AND CB.DocDate<=@AsOn AND  ((SELECT top(1) 1 FROM ACC_DocDetails ACC WITH(NOLOCK) WHERE ACC.VoucherNo=CB.DocNo and (StatusID=370 OR StatusID=439 OR StatusID=452))=1 OR (CB.DocType<>14 AND CB.DocType<>19 AND (SELECT top(1) 1 FROM ACC_DocDetails ACC WITH(NOLOCK) WHERE ACC.VoucherNo=CB.DocNo and (StatusID=369 or StatusID=429))=1))),0) Paid,(B.DocDueDate-B.DocDate) CreditDays,case when B.DocType=16 then (SELECT TOP 1 BD.BillNo FROM ACC_DocDetails BD WITH(NOLOCK) WHERE B.DocNo=BD.VoucherNo and B.DocSeqNo=BD.DocSeqNo) else (SELECT TOP 1 BD.BillNo FROM INV_DocDetails BD WITH(NOLOCK) WHERE B.DocNo=BD.VoucherNo) end BillNo,case when B.DocType=16 then (SELECT TOP 1 CONVERT(DATETIME, BD.BillDate) FROM ACC_DocDetails BD WITH(NOLOCK) WHERE B.DocNo=BD.VoucherNo and B.DocSeqNo=BD.DocSeqNo) else (SELECT TOP 1 CONVERT(DATETIME, BD.BillDate) FROM INV_DocDetails BD WITH(NOLOCK) WHERE B.DocNo=BD.VoucherNo) end BillDate,case when B.AdjAmount>0 then 1 else 0 end AmtOrder FROM COM_Billwise B WITH(NOLOCK) LEFT JOIN COM_Billwise BCB WITH(NOLOCK) ON BCB.AccountID=B.AccountID AND BCB.DocNo=B.DocNo and BCB.IsNewReference=1 AND BCB.DocSeqNo=B.DocSeqNo INNER JOIN ACC_Accounts A WITH(NOLOCK) ON B.AccountID=A.AccountID   WHERE B.IsNewReference=0 AND B.RefDocDate>@AsOn AND BCB.AccountID is null AND B.DocDate<=@AsOn AND ((SELECT top(1) 1 FROM ACC_DocDetails ACC WITH(NOLOCK) WHERE ACC.VoucherNo=B.DocNo and (StatusID=370 OR StatusID=439 OR StatusID=452))=1 OR (B.DocType<>14 AND B.DocType<>19 AND (SELECT top(1) 1 FROM ACC_DocDetails ACC WITH(NOLOCK) WHERE ACC.VoucherNo=B.DocNo and (StatusID=369 or StatusID=429))=1)) ORDER BY AccountName,AccountName_ID,DocDate,AmtOrder,DocNo'
