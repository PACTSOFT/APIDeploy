 'with rows as ( SELECT row_number() over (order by DDocID desc) rowno,* from (SELECT (select sum(DExQty) from (select  (case when D.LinkStatusID=445 then (CASE  WHEN D.costcenterid=40025 THEN D.Quantity WHEN D.costcenterid=40025 THEN D.Quantity ELSE D.Quantity END ) else (SELECT ISNULL(SUM(Qty),0) FROM (SELECT B.Quantity Qty FROM INV_DocDetails B with(nolock) WHERE D.InvDocDetailsID=B.LinkedInvDocDetailsID AND D.costcenterid=40025 AND B.costcenterid=40002 AND B.StatusID<>376 AND B.StatusID<>372 UNION ALL SELECT B.Quantity Qty FROM INV_DocDetails B with(nolock) WHERE D.InvDocDetailsID=B.LinkedInvDocDetailsID AND D.costcenterid=40025 AND B.costcenterid=41032 AND B.StatusID<>376 AND B.StatusID<>372) AS T) end ) DExQty
from INV_DocDetails D with(nolock) where D.DocID=INV.DocID
) AS T)
DExQty
, sum(INV.Quantity) DQty
,INV.DocID DDocID
,max(CONVERT(DATETIME,INV.DocDate)) DocDate,max(INV.VoucherNo) DocNo,max(T1.Status) Status,max(T1.StatusID) _StatusID,max(INV.CommonNarration) Narration,max(T2.AccountName) DrAccount,max(T3.AccountName) CrAccount,max(CONVERT(DATETIME,INV.DueDate)) DueDate
FROM INV_DocDetails INV with(nolock) left join COM_Status T1 with(nolock) on INV.StatusID=T1.StatusID left join ACC_Accounts T2 with(nolock) on INV.DebitAccount=T2.AccountID left join ACC_Accounts T3 with(nolock) on INV.CreditAccount=T3.AccountID
WHERE CONVERT(DATETIME,INV.DocDate) BETWEEN ''02 Jul 2025'' AND ''02 Jul 2026'' and INV.CostCenterID=40025
GROUP BY INV.DocID,INV.VoucherNo) AS T) select * from rows WHERE rowno>0 and rowno<=20 order by rowno
