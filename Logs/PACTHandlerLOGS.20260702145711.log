 'select CostCenterID,DocumentName,WebReportID,IsInventory,DocumentType from ADM_DocumentTypes with(nolock) where CostCenterID in (40012) order by DocumentName
declare @Tbl as Table(CostCenterID int,DocumentName nvarchar(100))
--Linked From
