[System: 192.168.1.99] DEBUG | 07/02/2026 15:47:44.575 | General Service|:: CompanyIndex:326 SpName: spADM_GetDataSet 
 'SELECT A.AccountName CustomerName,AEXT.acAlpha51 CustomerTIN,convert(datetime,INV.DocDate) DocDate,INV.VoucherNo VoucherNo,INV.DocAbbr [VoucherNoAbr],INV.DocPrefix [VoucherNoprf],CONVERT(BIGINT,INV.DocNumber) [VoucherNodno],INV.DocSeqNo DocSeqNo,P.ProductName ProductDescription,INV.Gross SupplyValueAED,NUM.dcCalcNum61 VATValueAED,TXT.dcAlpha153 TaxCode,DCC_58.Name Country,CUR.Symbol FCYCode,NUM.dcCalcNumFC51 SupplyFCY,NUM.dcCalcNumFC61 VATFCY
FROM INV_DocDetails INV with(nolock) inner join COM_DocCCData DCC with(nolock) on DCC.InvDocDetailsID=INV.InvDocDetailsID
inner join ACC_Accounts A with(nolock) on A.AccountID=INV.DebitAccount
inner join ACC_AccountsExtended AEXT with(nolock) on AEXT.AccountID=A.AccountID
inner join INV_Product P with(nolock) on P.ProductID=INV.ProductID
inner join COM_DocNumData NUM with(nolock) on NUM.InvDocDetailsID=INV.InvDocDetailsID
inner join COM_DocTextData TXT with(nolock) on TXT.InvDocDetailsID=INV.InvDocDetailsID
inner join COM_CC50058 DCC_58 with(nolock) on DCC_58.NodeID=DCC.dcCCNID58
inner join COM_Currency CUR with(nolock) on CUR.CurrencyID=INV.CurrencyID
WHERE INV.CostCenterID=40011 and INV.StatusID=369 and (INV.DynamicInvDocDetailsID is null or INV.DynamicInvDocDetailsID=0) and INV.DocDate between convert(float,convert(datetime,''01 Jul 2026'')) and convert(float,convert(datetime,''31 Jul 2026''))
ORDER BY DocDate,VoucherNoAbr,VoucherNoprf,VoucherNodno,DocSeqNo'
 ,1
 ,1
