[System: 192.168.1.99] DEBUG | 07/02/2026 15:47:46.476 | General Service|:: CompanyIndex:326 SpName: spADM_GetDataSet 
 'SELECT A.AccountName SupplierName,AEXT.acAlpha51 SupplierTIN,convert(datetime,INV.DocDate) DocDate,INV.VoucherNo VoucherNo,INV.DocAbbr [VoucherNoAbr],INV.DocPrefix [VoucherNoprf],CONVERT(BIGINT,INV.DocNumber) [VoucherNodno],NULL PermitNo,INV.DocSeqNo DocSeqNo,P.ProductName ProductDescription,NUM.dcCalcNum51 PurchaseValueAED,NUM.dcCalcNum61 VATValueAED,TXT.dcAlpha152 TaxCode,CUR.Symbol FCYCode,0.0 PurchaseFCY,0.0 AEDFCY
FROM INV_DocDetails INV with(nolock) inner join COM_DocCCData DCC with(nolock) on DCC.InvDocDetailsID=INV.InvDocDetailsID
inner join ACC_Accounts A with(nolock) on A.AccountID=INV.CreditAccount
inner join ACC_AccountsExtended AEXT with(nolock) on AEXT.AccountID=A.AccountID
inner join INV_Product P with(nolock) on P.ProductID=INV.ProductID
inner join COM_DocNumData NUM with(nolock) on NUM.InvDocDetailsID=INV.InvDocDetailsID
inner join COM_DocTextData TXT with(nolock) on TXT.InvDocDetailsID=INV.InvDocDetailsID
inner join COM_Currency CUR with(nolock) on CUR.CurrencyID=INV.CurrencyID
WHERE INV.CostCenterID=40001 and INV.StatusID=369 and (INV.DynamicInvDocDetailsID is null or INV.DynamicInvDocDetailsID=0) and INV.DocDate between convert(float,convert(datetime,''01 Jul 2026'')) and convert(float,convert(datetime,''31 Jul 2026''))
UNION ALL
SELECT A.AccountName,AEXT.acAlpha51,convert(datetime,INV.DocDate),INV.VoucherNo,INV.DocAbbr,INV.DocPrefix,CONVERT(BIGINT,INV.DocNumber),NULL,INV.DocSeqNo,P.ProductName,NUM.dcCalcNum51,NUM.dcCalcNum61,TXT.dcAlpha152,CUR.Symbol,0.0,0.0
FROM INV_DocDetails INV with(nolock) inner join COM_DocCCData DCC with(nolock) on DCC.InvDocDetailsID=INV.InvDocDetailsID
inner join ACC_Accounts A with(nolock) on A.AccountID=INV.CreditAccount
inner join ACC_AccountsExtended AEXT with(nolock) on AEXT.AccountID=A.AccountID
inner join INV_Product P with(nolock) on P.ProductID=INV.ProductID
inner join COM_DocNumData NUM with(nolock) on NUM.InvDocDetailsID=INV.InvDocDetailsID
inner join COM_DocTextData TXT with(nolock) on TXT.InvDocDetailsID=INV.InvDocDetailsID
inner join COM_Currency CUR with(nolock) on CUR.CurrencyID=INV.CurrencyID
WHERE INV.CostCenterID=41021 and INV.StatusID=369 and (INV.DynamicInvDocDetailsID is null or INV.DynamicInvDocDetailsID=0) and INV.DocDate between convert(float,convert(datetime,''01 Jul 2026'')) and convert(float,convert(datetime,''31 Jul 2026''))
UNION ALL
SELECT A.AccountName,AEXT.acAlpha51,convert(datetime,INV.DocDate),INV.VoucherNo,INV.DocAbbr,INV.DocPrefix,CONVERT(BIGINT,INV.DocNumber),NULL,INV.DocSeqNo,P.ProductName,NUM.dcCalcNum51,NUM.dcCalcNum61,TXT.dcAlpha152,CUR.Symbol,0.0,0.0
FROM INV_DocDetails INV with(nolock) inner join COM_DocCCData DCC with(nolock) on DCC.InvDocDetailsID=INV.InvDocDetailsID
inner join ACC_Accounts A with(nolock) on A.AccountID=INV.CreditAccount
inner join ACC_AccountsExtended AEXT with(nolock) on AEXT.AccountID=A.AccountID
inner join INV_Product P with(nolock) on P.ProductID=INV.ProductID
inner join COM_DocNumData NUM with(nolock) on NUM.InvDocDetailsID=INV.InvDocDetailsID
inner join COM_DocTextData TXT with(nolock) on TXT.InvDocDetailsID=INV.InvDocDetailsID
inner join COM_Currency CUR with(nolock) on CUR.CurrencyID=INV.CurrencyID
WHERE INV.CostCenterID=41000 and INV.StatusID=369 and (INV.DynamicInvDocDetailsID is null or INV.DynamicInvDocDetailsID=0) and INV.DocDate between convert(float,convert(datetime,''01 Jul 2026'')) and convert(float,convert(datetime,''31 Jul 2026''))
ORDER BY DocDate,VoucherNoAbr,VoucherNoprf,VoucherNodno,DocSeqNo'
 ,1
