(SELECT SUM(CB.AdjAmount) Adjusted FROM COM_Billwise CB WITH(NOLOCK) WHERE CB.IsNewReference=0 AND CB.DocDate<=@To AND CB.AccountID=B.AccountID AND CB.RefDocNo=B.DocNo AND  CB.DocType<>14 AND CB.DocType<>19 AND (SELECT top(1) 1 FROM ACC_DocDetails ACC WITH(NOLOCK) WHERE ACC.VoucherNo=CB.DocNo and (StatusID=369 or StatusID=429))=1 AND CB.RefDocSeqNo=B.DocSeqNo) Adjusted,(B.DocDueDate-B.DocDate) CreditDays
