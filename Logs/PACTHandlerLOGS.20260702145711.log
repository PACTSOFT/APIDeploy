 'DECLARE @SQL NVARCHAR(MAX),@LDPref bit,@CCId INT ,@LDBONRolePref bit , @LUBOnPref bit
                        SET @CCId=50001
                        SET @SQL='' select FeatureID,Name, TableName from ADM_Features with(nolock) where FeatureID>50000 and IsEnabled=1 ''

                        SELECT @LDBONRolePref=ISNULL(Value,0) From COM_CostCenterPreferences WHERE CostCenterID=@CCId AND Name=''LoadDimensionsBasedOnRoleInAssignTab''
                        IF(@LDBONRolePref = 1)
                            SET @SQL+='' AND FeatureID IN (select FA.FeatureID from adm_featureactionrolemap FAR with(nolock)
inner join adm_featureaction FA with(nolock) on FAR.FeatureActionID=FA.FeatureActionID
where FAR.RoleID=1 and (FA.FeatureActionTypeID=1 or FA.FeatureActionTypeID=2)) ''

                        SELECT @LDPref=ISNULL(Value,0) From COM_CostCenterPreferences WHERE CostCenterID=@CCId AND Name=''LoadDocumentsInAssignTab''
                        IF(@LDPref=1)
                            SET @SQL+='' UNION ALL select 300,''''Documents'''',''''ADM_DocumentTypes''''''

	                    SELECT @LUBOnPref=ISNULL(Value,0) From COM_CostCenterPreferences WHERE CostCenterID=@CCId AND Name=''EnableLoadUserDataBasedOnMappedFields''
                        IF(@LUBOnPref=1)
                           SET @SQL+='' UNION ALL  select FeatureID,Name, TableName from ADM_Features where FeatureID =7''
                        SET @SQL+='' ORDER BY Name ''
                        IF(@CCId > 50000)
                            SET @SQL+='' select ListViewTypeID TypeID,CostCenterID from ADM_ListViewCCMap with(nolock) where SourceCostCenterID=''+CONVERT(NVARCHAR,@CCId) 
            
                        EXEC(@SQL)'
 ,1
