[System: 192.168.1.99] DEBUG | 07/02/2026 16:40:00.941 | General Service|:: CompanyIndex:53 SpName: spADM_GetDataSet 
 'DECLARE @SQL NVARCHAR(MAX),@Rcnt INt,@RId INT,@UserColumnName NVARCHAR(MAX),@SysTableName NVARCHAR(MAX),@SysColName NVARCHAR(MAX)
                                DECLARE @TEMP TABLE(ID INT IDENTITY(1,1),SysColName NVARCHAR(MAX),UserColumnName NVARCHAR(MAX),SysTableName NVARCHAR(MAX))
                                SET @SQL=''''
                                INSERT INTO @TEMP		
                                SELECT SysColumnName,UserColumnName,ParentCostCenterSysName FROM ADM_CostCenterDef WITH(NOLOCK) WHERE CostCenterID=50051 AND SysColumnName LIKE''CCNID%'' AND IsColumnInUse=1
                                SET @RCnt=@@ROWCOUNT
                                SET @RId=1
                                SET @SQL=@SQL+''SELECT ''''RptManager'''' as SysColName,''''RptManager'''' as UserColumnName,NODEID as NodeID,CODE as Code,NAME as Name FROM COM_CC50051 WITH(NOLOCK) WHERE NODEID>0 ''                                                            
                                WHILE(@RId<=@RCnt)
                                BEGIN
	
	                            SELECT @SysColName=SysColName,@UserColumnName=UserColumnName,@SysTableName=SysTableName FROM @TEMP WHERE ID=@RId
	
	                            IF(LEN(@SQL)>0)
	                            BEGIN
	                            SET @SQL=@SQL + '' 
	                            UNION ''
	                            END
    
                                SET @SQL=@SQL+''SELECT ''''''+@SysColName+'''''' as SysColName,''''''+@UserColumnName+'''''' as UserColumnName,NODEID as NodeID,CODE as Code,NAME as Name FROM ''+@SysTableName+'' WITH(NOLOCK) WHERE NODEID>0 ''
	                            SET @RId=@RId+1
	
                                END
                                EXEC(@SQL)'
 ,20038
 ,1
