 '
SELECT CurrencyID,[Name],[Symbol],[Change],NmResourceID,ChResourceID,
b.ResourceData as EngNmResourceData,b1.ResourceData as ArNmResourceData,
c.ResourceData as EngChResourceData,c1.ResourceData as ArChResourceData
FROM [COM_Currency] a with(nolock) 
JOIN COM_LanguageResources b WITH(NOLOCK) on a.NmResourceID=b.ResourceID AND b.LanguageID=1
JOIN COM_LanguageResources b1 WITH(NOLOCK) on a.NmResourceID=b1.ResourceID AND b1.LanguageID=2

JOIN COM_LanguageResources c WITH(NOLOCK) on a.ChResourceID=c.ResourceID AND c.LanguageID=1
JOIN COM_LanguageResources c1 WITH(NOLOCK) on a.ChResourceID=c1.ResourceID AND c1.LanguageID=2
ORDER BY IsBaseCurrency DESC
'
