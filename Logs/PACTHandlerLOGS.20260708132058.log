FROM ACC_DocDetails ACC with(nolock) left join COM_Status T1 with(nolock) on ACC.StatusID=T1.StatusID left join ACC_Accounts T2 with(nolock) on ACC.DebitAccount=T2.AccountID left join ACC_Accounts T3 with(nolock) on ACC.CreditAccount=T3.AccountID
WHERE CONVERT(DATETIME,ACC.DocDate) BETWEEN ''07 Jul 2025'' AND ''07 Jul 2026'' AND ACC.LinkedAccDocDetailsID is null and ACC.CostCenterID=40022
GROUP BY ACC.DocID,ACC.VoucherNo) select * from rows WHERE rowno>0 and rowno<=20 order by rowno
select S.StatusID,S.Status,count(*) CNT from (
SELECT ACC.StatusID,ACC.DocID
FROM ACC_DocDetails ACC with(nolock) left join COM_Status T1 with(nolock) on ACC.StatusID=T1.StatusID left join ACC_Accounts T2 with(nolock) on ACC.DebitAccount=T2.AccountID left join ACC_Accounts T3 with(nolock) on ACC.CreditAccount=T3.AccountID
WHERE CONVERT(DATETIME,ACC.DocDate) BETWEEN ''07 Jul 2025'' AND ''07 Jul 2026'' AND ACC.LinkedAccDocDetailsID is null and ACC.CostCenterID=40022
GROUP BY ACC.StatusID,ACC.DocID,ACC.VoucherNo) AS T
join COM_Status S with(nolock) on S.StatusID=T.StatusID
group by S.StatusID,S.Status'
