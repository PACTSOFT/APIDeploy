 ' declare @EmpSeqNo int,@Grade int,@IsGradeWise BIT
                      SET @EmpSeqNo=931

          SELECT @IsGradeWise=CONVERT(BIT,Value) FROM ADM_GlobalPreferences WITH(NOLOCK) WHERE Name=''GradeWiseGratuity''
                IF @IsGradeWise=1
	                SELECT TOP 1 @Grade=HistoryNodeID FROM COM_HistoryDetails WITH(NOLOCK) 
	                WHERE NodeID=@EmpSeqNo AND CostCenterID=50051 AND HistoryCCID=50053 AND ToDate IS NULL

                IF @Grade IS NULL
	                SET @Grade=1
                --0 
                SELECT a.DocID,a.CostCenterID,a.DocumentType,a.VoucherNo,CONVERT(DateTime,a.DocDate) as DocDate,
                B.dcCCNID53 as GradeID,
                d.dcAlpha5 as ResExp,d.dcAlpha6 as ResGrDays,d.dcAlpha7 as ResApplyPrevYrs,d.dcAlpha9 as TermExp,d.dcAlpha10 as TermGrDays,d.dcAlpha11 as TermApplyPrevYrs,
                d.dcAlpha1 as MaxDays,d.dcAlpha2 as Formula,d.dcAlpha3 as ROff,d.dcAlpha4 as ExcludeLOP,d.dcAlpha12 as CalcBasedOn,d.dcAlpha13 as AvailedFormula,d.dcAlpha15 ROffYear,
                d.dcAlpha17 as ExpiredExp,d.dcAlpha18 as ExpiredGrDays,d.dcAlpha19 as ExpiredApplyPrevYrs,d.dcAlpha20 ConsdExpiredupto,d.*    
                FROM INV_DocDetails A WITH(NOLOCK) 
                JOIN COM_DocCCData B WITH(NOLOCK) ON B.INVDOCDETAILSID=a.INVDOCDETAILSID
                JOIN COM_DocNumData c WITH(NOLOCK) ON c.INVDOCDETAILSID=a.INVDOCDETAILSID
                JOIN COM_DocTextData d WITH(NOLOCK) ON d.INVDOCDETAILSID=a.INVDOCDETAILSID
                WHERE D.tCostCenterID=40075 and a.StatusID=369 AND B.dcCCNID53=@Grade 
                AND ISDATE(D.DCAlpha14)=1 AND CONVERT(DATETIME,D.DCAlpha14)=(SELECT TOP 1 CONVERT(DATETIME,T.DCAlpha14) FROM INV_DocDetails I WITH(NOLOCK) 
                JOIN COM_DocCCData C WITH(NOLOCK) ON C.INVDOCDETAILSID=I.INVDOCDETAILSID
                JOIN COM_DocTextData T WITH(NOLOCK) ON T.INVDOCDETAILSID=I.INVDOCDETAILSID
				WHERE T.tCostCenterID=40075 and I.StatusID=369 AND C.dcCCNID53=@Grade AND ISDATE(T.DCAlpha14)=1 AND CONVERT(DATETIME,T.DCAlpha14)<=CONVERT(DATETIME,''07 Aug 2025'')
				ORDER BY CONVERT(DATETIME,T.DCAlpha14) DESC)
                ORDER BY A.DocSeqNo 
--1
Select c.NodeID,c.LookupType,c.Name,a.CostCenterID,a.UserColumnName,a.SysColumnName
FROM ADM_CostCenterDef a WITH(NOLOCK)
JOIN ADM_CostCenterDef b WITH(NOLOCK) on b.CostCenterID=79 AND b.SysColumnName=''PayFFSOtherAdditions'' AND b.CostCenterColID=a.LinkData 
JOIN COM_Lookup c WITH(NOLOCK) on c.AliasName=a.UserColumnName
Where a.CostCenterID=40075 AND a.LocalReference=79

--2

SELECT ISNULL(SUM(dcCalcNum4),0) GratuityTaken
                    FROM INV_DocDetails a WITH(NOLOCK) 
                    JOIN COM_DocCCData b WITH(NOLOCK) ON b.InvDocDetailsID=a.InvDocDetailsID
                    JOIN COM_DocNumData c WITH(NOLOCK) ON c.InvDocDetailsID=a.InvDocDetailsID
                    JOIN COM_DocTextData d WITH(NOLOCK) ON d.InvDocDetailsID=a.InvDocDetailsID
                    JOIN COM_Status e WITH(NOLOCK) ON e.StatusID=a.StatusID and e.CostCenterID=400
                    WHERE D.tCostCenterID=40095 AND dcAlpha1=''1'' AND dcAlpha2=''1'' AND b.dcCCNID51=931'
 ,1
 ,1
