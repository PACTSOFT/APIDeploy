[System: 192.168.1.170] DEBUG | 08-07-2025 19:50:16.667 | General Service|:: CompanyIndex:134 SpName: spADM_GetDataSet 
 '

DECLARE @MinPayDate DATETIME,@ConsLOP NVARCHAR(100),@SQL NVARCHAR(MAX)
SELECT @ConsLOP=Value from ADM_GlobalPreferences WITH(NOLOCK) where Name=''ConsiderLOPBasedOn''

IF(@ConsLOP IS NOT NULL AND @ConsLOP<>'''')
BEGIN
SELECT @MinPayDate=MIN(CONVERT(DATETIME,a.DueDate)) 
FROM INV_DocDetails a WITH(NOLOCK) 
WHERE a.CostCenterID=40054 and a.StatusID=369

IF(@MinPayDate IS NOT NULL AND @MinPayDate<>'''')
BEGIN
SET @SQL=''
SELECT ISNULL(SUM(CONVERT(FLOAT,ISNULL(dcAlpha7,0))),0) as LOPDays
FROM INV_DocDetails a WITH(NOLOCK) 
JOIN COM_DocCCData b WITH(NOLOCK) ON b.InvDocDetailsID=a.InvDocDetailsID
JOIN COM_DocNumData c WITH(NOLOCK) ON c.InvDocDetailsID=a.InvDocDetailsID
JOIN COM_DocTextData d WITH(NOLOCK) ON d.InvDocDetailsID=a.InvDocDetailsID
WHERE D.tCostCenterID=40062 and a.StatusID=369
AND ISDATE(d.dcAlpha4)=1 
AND b.dcCCNID51=931 AND b.dcCCNID52 IN (''+@ConsLOP+'')
AND  CONVERT(DATETIME,(''''01 ''''+SUBSTRING(CONVERT(VARCHAR(11), CONVERT(DATETIME,d.dcAlpha4),113),4,8))) BETWEEN CONVERT(DATETIME,''''01/Dec/2023'''') AND CONVERT(DATETIME,''''01/Aug/2025'''')
AND DATEDIFF(day,CONVERT(DATETIME,d.dcAlpha4),''''''+CONVERT(NVARCHAR,@MinPayDate)+'''''')>0 
''
EXEC(@SQL)
END
ELSE
BEGIN
  SELECT 0 as LOPDays
END
END
ELSE
BEGIN
SELECT 0 as LOPDays
END
'
 ,1
 ,1
