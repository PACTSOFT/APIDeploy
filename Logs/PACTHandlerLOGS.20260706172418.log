WHERE CONVERT(DATETIME,INV.DocDate) BETWEEN ''06 Jul 2025'' AND ''06 Jul 2026'' and INV.CostCenterID=40007
GROUP BY INV.DocID,INV.VoucherNo) AS T) select * from rows WHERE rowno>0 and rowno<=20 order by rowno
