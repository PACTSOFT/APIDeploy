 'with rows as ( SELECT row_number() over (order by DDocID desc) rowno,* from (SELECT (select sum(DExQty) from (select  (case when D.LinkStatusID=445 then (CASE  WHEN D.costcenterid=40007 THEN D.Quantity WHEN D.costcenterid=40007 THEN D.Quantity WHEN D.costcenterid=40007 THEN D.Quantity ELSE D.Quantity END ) else (SELECT ISNULL(SUM(Qty),0) FROM (SELECT B.Quantity Qty FROM INV_DocDetails B with(nolock) WHERE D.InvDocDetailsID=B.LinkedInvDocDetailsID AND D.costcenterid=40007 AND B.costcenterid=40011 AND B.StatusID<>376 AND B.StatusID<>372 UNION ALL SELECT B.Quantity Qty FROM INV_DocDetails B with(nolock) WHERE D.InvDocDetailsID=B.LinkedInvDocDetailsID AND D.costcenterid=40007 AND B.costcenterid=40012 AND B.StatusID<>376 AND B.StatusID<>372 UNION ALL SELECT B.Quantity Qty FROM INV_DocDetails B with(nolock) WHERE D.InvDocDetailsID=B.LinkedInvDocDetailsID AND D.costcenterid=40007 AND B.costcenterid=40210 AND B.StatusID<>376 AND B.StatusID<>372) AS T) end ) DExQty
from INV_DocDetails D with(nolock) where D.DocID=INV.DocID
) AS T)
DExQty
, sum(INV.Quantity) DQty
,INV.DocID DDocID
,max(CONVERT(DATETIME,INV.DocDate)) DocDate,max(INV.VoucherNo) DocNo,max(T1.Status) Status,max(T1.StatusID) _StatusID,max(INV.CommonNarration) Narration,max(T2.AccountName) DrAccount,max(T3.AccountName) CrAccount
