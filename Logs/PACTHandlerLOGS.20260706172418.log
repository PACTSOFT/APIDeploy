[System: 192.168.1.54] DEBUG | 07/06/2026 18:06:11.513 | General Service|:: CompanyIndex:1 SpName: spADM_GetDataSet 
 'DECLARE @To FLOAT
SET @To=CONVERT(FLOAT,CONVERT(DATETIME,''06 Jul 2026''))
SELECT *,case when Amount>0 then 1 else 0 end AmtOrder FROM (	SELECT A.AccountID,B.DocSeqNo,A.AccountName AS AccountName,A.AccountID AS AccountName_ID,CONVERT(DATETIME,B.DocDate) DocDate,CONVERT(DATETIME,B.DocDueDate) DueDate,CONVERT(DATETIME,B.DocDate) VoucherDate,B.DocNo,AdjAmount+ISNULL((select sum(CB.AdjAmount) from COM_Billwise CB WITH(NOLOCK) where CB.AccountID=B.AccountID AND CB.DocNo=B.DocNo and CB.IsNewReference=0 AND CB.DocSeqNo=B.DocSeqNo AND CB.RefDocDate>@To),0) Amount,AdjAmount BillAmount,C50002.Name AS Location,    
(SELECT SUM(AdjAmount) Adjusted FROM COM_Billwise CB WITH(NOLOCK) WHERE CB.IsNewReference=0 AND CB.DocDate<=@To AND CB.AccountID=B.AccountID AND CB.RefDocNo=B.DocNo AND  (CB.DocType<>14 AND CB.DocType<>19 AND (SELECT top(1) 1 FROM ACC_DocDetails ACC WITH(NOLOCK) WHERE ACC.VoucherNo=CB.DocNo and (StatusID=369 or StatusID=429 or StatusID=371 or StatusID=441))=1) AND CB.RefDocSeqNo=B.DocSeqNo) Adjusted,(B.DocDueDate-B.DocDate) CreditDays
,@To-B.DocDate OverDue
,B.DocType,(SELECT TOP 1 ACC.StatusID FROM ACC_DocDetails ACC WITH(NOLOCK) WHERE ACC.VoucherNo=B.DocNo) StatusID,case when B.DocType=14 or B.DocType=19 then 1 else 0 end IsPDC,null AgainstVoucher 
FROM COM_Billwise B WITH(NOLOCK) INNER JOIN ACC_Accounts A WITH(NOLOCK) ON B.AccountID=A.AccountID     
INNER JOIN COM_Location AS C50002 WITH(NOLOCK) ON B.dcCCNID2 = C50002.NodeID  WHERE B.IsNewReference=1 AND B.DocDate<=@To AND A.AccountID=140 ) AS T  WHERE (Adjusted IS NULL OR abs(Amount+Adjusted)>0.099) AND (DocType<>14 AND DocType<>19 and (StatusID=369 or StatusID=429 or StatusID=371 or StatusID=441))
 UNION ALL  SELECT *,case when Amount>0 then 1 else 0 end AmtOrder FROM (	SELECT A.AccountID,B.DocSeqNo,A.AccountName AS AccountName,A.AccountID AS AccountName_ID,CONVERT(DATETIME,B.DocDate) DocDate,CONVERT(DATETIME,B.DocDueDate) DueDate,CONVERT(DATETIME,B.DocDate) VoucherDate,B.DocNo,B.AdjAmount Amount,B.AdjAmount BillAmount,C50002.Name AS Location,    
(SELECT SUM(CB.AdjAmount) Adjusted FROM COM_Billwise CB WITH(NOLOCK) WHERE CB.IsNewReference=0 AND CB.DocDate<=@To AND CB.AccountID=B.AccountID AND CB.RefDocNo=B.DocNo AND  (CB.DocType<>14 AND CB.DocType<>19 AND (SELECT top(1) 1 FROM ACC_DocDetails ACC WITH(NOLOCK) WHERE ACC.VoucherNo=CB.DocNo and (StatusID=369 or StatusID=429 or StatusID=371 or StatusID=441))=1) AND CB.RefDocSeqNo=B.DocSeqNo) Adjusted,(B.DocDueDate-B.DocDate) CreditDays
 ,@To-B.DocDate OverDue
 ,B.DocType,(SELECT TOP 1 ACC.StatusID FROM ACC_DocDetails ACC WITH(NOLOCK) WHERE ACC.VoucherNo=B.DocNo) StatusID,case when B.DocType=14 or B.DocType=19 then 1 else 0 end IsPDC,null AgainstVoucher 
 FROM COM_Billwise B WITH(NOLOCK) INNER JOIN ACC_Accounts A WITH(NOLOCK) ON B.AccountID=A.AccountID     
 INNER JOIN COM_Location AS C50002 WITH(NOLOCK) ON B.dcCCNID2 = C50002.NodeID  
 LEFT JOIN COM_Billwise BCB WITH(NOLOCK) ON BCB.AccountID=B.AccountID AND BCB.DocNo=B.DocNo and BCB.IsNewReference=1 AND BCB.DocSeqNo=B.DocSeqNo  WHERE B.IsNewReference=0 AND B.DocDate<=@To AND B.RefDocDate>@To AND BCB.AccountID is null AND A.AccountID=140 ) AS T  WHERE (Adjusted IS NULL OR abs(Amount+Adjusted)>0.099) AND (DocType<>14 AND DocType<>19 and (StatusID=369 or StatusID=429 or StatusID=371 or StatusID=441))
UNION ALL  SELECT *,case when Amount>0 then 1 else 0 end AmtOrder FROM (	SELECT A.AccountID,B.DocSeqNo,A.AccountName AS AccountName,A.AccountID AS AccountName_ID,CONVERT(DATETIME,B.DocDate) DocDate,CONVERT(DATETIME,B.DocDueDate) DueDate,CONVERT(DATETIME,B.DocDate) VoucherDate,B.DocNo,
AdjAmount Amount,AdjAmount BillAmount,C50002.Name AS Location,0 Adjusted
,(B.DocDueDate-B.DocDate) CreditDays
,@To-B.DocDate OverDue
,B.DocType,(SELECT TOP 1 ACC.StatusID FROM ACC_DocDetails ACC WITH(NOLOCK) WHERE ACC.VoucherNo=B.DocNo) StatusID,1 IsPDC,case when B.IsNewReference=0 then B.RefDocNo else null end AgainstVoucher 
FROM COM_Billwise B WITH(NOLOCK) INNER JOIN ACC_Accounts A WITH(NOLOCK) ON B.AccountID=A.AccountID     
INNER JOIN COM_Location AS C50002 WITH(NOLOCK) ON B.dcCCNID2 = C50002.NodeID  WHERE (B.DocType=19 or B.DocType=14) and B.DocDate<=@To  AND A.AccountID=140 ) AS T  WHERE (Adjusted IS NULL OR abs(Amount+Adjusted)>0.099) AND (StatusID=370 OR StatusID=439 or StatusID=371 or StatusID=441) ORDER BY AccountName,AccountName_ID,IsPDC,StatusID,DocDate,AmtOrder,DocNo'
