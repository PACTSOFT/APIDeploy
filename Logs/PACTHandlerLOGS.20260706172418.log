[System: 192.168.1.54] DEBUG | 07/06/2026 18:02:11.336 | General Service|:: CompanyIndex:1 SpName: spADM_GetDataSet 
 'with rows as ( SELECT row_number() over (order by INV.DocID desc) rowno,max(CONVERT(DATETIME,INV.DocDate)) DocDate,max(INV.VoucherNo) DocNo,max(T1.Status) Status,max(T1.StatusID) _StatusID,max(INV.CommonNarration) Narration,max(T2.AccountName) DrAccount,max(T3.AccountName) CrAccount
FROM INV_DocDetails INV with(nolock) left join COM_Status T1 with(nolock) on INV.StatusID=T1.StatusID left join ACC_Accounts T2 with(nolock) on INV.DebitAccount=T2.AccountID left join ACC_Accounts T3 with(nolock) on INV.CreditAccount=T3.AccountID
WHERE CONVERT(DATETIME,INV.DocDate) BETWEEN ''06 Jul 2025'' AND ''06 Jul 2026'' and INV.CostCenterID=40009
GROUP BY INV.DocID,INV.VoucherNo) select * from rows WHERE rowno>0 and rowno<=20 order by rowno
select S.StatusID,S.Status,count(*) CNT from (
SELECT INV.StatusID,INV.DocID
FROM INV_DocDetails INV with(nolock) left join COM_Status T1 with(nolock) on INV.StatusID=T1.StatusID left join ACC_Accounts T2 with(nolock) on INV.DebitAccount=T2.AccountID left join ACC_Accounts T3 with(nolock) on INV.CreditAccount=T3.AccountID
WHERE CONVERT(DATETIME,INV.DocDate) BETWEEN ''06 Jul 2025'' AND ''06 Jul 2026'' and INV.CostCenterID=40009
GROUP BY INV.StatusID,INV.DocID,INV.VoucherNo) AS T
join COM_Status S with(nolock) on S.StatusID=T.StatusID
group by S.StatusID,S.Status'
 ,1
 ,1
