WHERE CONVERT(DATETIME,ACC.DocDate) BETWEEN ''06 Jul 2025'' AND ''06 Jul 2026'' AND ACC.LinkedAccDocDetailsID is null and ACC.CostCenterID=40018
GROUP BY ACC.StatusID,ACC.DocID,ACC.VoucherNo) AS T
join COM_Status S with(nolock) on S.StatusID=T.StatusID
