[System: 192.168.1.54] DEBUG | 07/06/2026 18:05:27.470 | General Service|:: CompanyIndex:1 SpName: spADM_GetDataSet 
 'with rows as ( SELECT row_number() over (order by ACC.DocID desc) rowno,max(CONVERT(DATETIME,ACC.DocDate)) DocDate,max(ACC.VoucherNo) DocNo,sum(convert(float,ACC.Amount)) Amount,max(T1.Status) Status,max(T1.StatusID) _StatusID,max(T2.AccountName) DrAccount,max(T3.AccountName) CrAccount,max(ACC.CommonNarration) Narration
FROM ACC_DocDetails ACC with(nolock) left join COM_Status T1 with(nolock) on ACC.StatusID=T1.StatusID left join ACC_Accounts T2 with(nolock) on ACC.DebitAccount=T2.AccountID left join ACC_Accounts T3 with(nolock) on ACC.CreditAccount=T3.AccountID
WHERE CONVERT(DATETIME,ACC.DocDate) BETWEEN ''06 Jul 2025'' AND ''06 Jul 2026'' AND ACC.LinkedAccDocDetailsID is null and ACC.CostCenterID=40022
GROUP BY ACC.DocID,ACC.VoucherNo) select * from rows WHERE rowno>0 and rowno<=20 order by rowno
select S.StatusID,S.Status,count(*) CNT from (
SELECT ACC.StatusID,ACC.DocID
FROM ACC_DocDetails ACC with(nolock) left join COM_Status T1 with(nolock) on ACC.StatusID=T1.StatusID left join ACC_Accounts T2 with(nolock) on ACC.DebitAccount=T2.AccountID left join ACC_Accounts T3 with(nolock) on ACC.CreditAccount=T3.AccountID
WHERE CONVERT(DATETIME,ACC.DocDate) BETWEEN ''06 Jul 2025'' AND ''06 Jul 2026'' AND ACC.LinkedAccDocDetailsID is null and ACC.CostCenterID=40022
GROUP BY ACC.StatusID,ACC.DocID,ACC.VoucherNo) AS T
join COM_Status S with(nolock) on S.StatusID=T.StatusID
group by S.StatusID,S.Status'
 ,1
 ,1
