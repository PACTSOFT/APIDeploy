[System: 192.168.1.54] DEBUG | 07/06/2026 18:05:13.246 | General Service|:: CompanyIndex:1 SpName: spADM_GetDataSet 
 'select CostCenterID,DocumentName,WebReportID,IsInventory,DocumentType from ADM_DocumentTypes with(nolock) where CostCenterID in (40018) order by DocumentName
declare @Tbl as Table(CostCenterID int,DocumentName nvarchar(100))
--Linked From
insert into @Tbl
select D.CostCenterID,D.DocumentName
from COM_DocumentLinkDef L with(nolock)
JOIN ADM_DocumentTypes D with(nolock) on D.CostCenterID=L.CostCenterIDLinked
where L.CostCenterIDBase in (40018)
order by DocumentName

select * from @Tbl

--Generate
select L.DocumentLinkDefID,L.CostCenterIDLinked CCID,D.CostCenterID,D.DocumentName
from COM_DocumentLinkDef L with(nolock)
JOIN ADM_DocumentTypes D with(nolock) on D.CostCenterID=L.CostCenterIDBase
JOIN @Tbl T on T.CostCenterID=L.CostCenterIDLinked
union
select L.DocumentLinkDefID,L.CostCenterIDLinked CCID,D.CostCenterID,D.DocumentName
from COM_DocumentLinkDef L with(nolock)
JOIN ADM_DocumentTypes D with(nolock) on D.CostCenterID=L.CostCenterIDBase
where L.CostCenterIDLinked in (40018)
order by CCID,DocumentName

select D.CostCenterID,D.PrefName,D.PrefValue from COM_DocumentPreferences D with(nolock)
where D.CostCenterID in (40018) and PrefName in (''DonotupdateAccounts'',''Selective'')
union all
select D.CostCenterID,D.PrefName,D.PrefValue from COM_DocumentPreferences D with(nolock)
JOIN @Tbl T on T.CostCenterID=D.CostCenterID
where PrefName in (''DonotupdateAccounts'',''Selective'')
'
