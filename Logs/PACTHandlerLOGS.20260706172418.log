[System: 192.168.1.54] DEBUG | 07/06/2026 18:05:43.643 | General Service|:: CompanyIndex:1 SpName: spADM_GetDataSet 
 'declare @DocNo nvarchar(100),@DetailsID bigint
set @DocNo=''RCT-97412''
select @DetailsID=min(AccDocDetailsID) from ACC_DocDetails with(nolock) where VoucherNo=@DocNo
select CreatedBy,CONVERT(Datetime,CreatedDate) CreateDate from ACC_DocDetails with(nolock)
where AccDocDetailsID=@DetailsID

select @DetailsID=max(AccDocDetailsID) from ACC_DocDetails with(nolock) where VoucherNo=@DocNo
select ModifiedBy,CONVERT(Datetime,ModifiedDate) ModifiedDate from ACC_DocDetails with(nolock)
where AccDocDetailsID=@DetailsID

select A.AccountName,sum(Dr) Dr,sum(Cr) Cr
from(
select DebitAccount Account,Amount Dr, 0 Cr
from ACC_DocDetails with(nolock)
where VoucherNo=@DocNo
union all
select CreditAccount,0,Amount
from ACC_DocDetails with(nolock)
where VoucherNo=@DocNo
) AS T
join ACC_Accounts A with(nolock) on A.AccountID=T.Account
Group By A.AccountName
order by Dr desc,Cr desc'
