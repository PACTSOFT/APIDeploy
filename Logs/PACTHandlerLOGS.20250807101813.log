[System: 192.168.1.99] DEBUG | 08-07-2025 16:55:58.658 | General Service|:: CompanyIndex:53 SpName: spADM_GetDataSet 
 '
DECLARE @Grade int,@IsGradeWiseMP BIT
SELECT @IsGradeWiseMP=CONVERT(BIT,Value) FROM ADM_GlobalPreferences WITH(NOLOCK)
WHERE Name=''GradeWiseMonthlyPayroll''
SET @Grade= 1

IF @IsGradeWiseMP=1
BEGIN
    SELECT TOP 1 @Grade= ISNULL(HistoryNodeID,1) FROM COM_HistoryDetails WITH(NOLOCK) 
	WHERE NodeID=0 AND CostCenterID=50051 AND HistoryCCID=50053   
	ORDER BY FromDate DESC
END
IF @Grade IS NULL
    SET @Grade= 1

SELECT b.Name as ComponentName,CONVERT(DATETIME,a.PayrollDate) as PayrollMonth,isnull(b.AliasName,'''') ResourceData,a.* 
,ROW_NUMBER() OVER (PARTITION BY Type ORDER BY Type) AS Serial
FROM COM_CC50054 a WITH(NOLOCK) 
LEFT JOIN COM_CC50052 b WITH(NOLOCK) on b.NodeID=a.ComponentID
WHERE a.GradeID=@Grade AND DATEDIFF(DAY,PayrollDate,''01-Aug-2025'')=0
Order By a.Type,a.SNo 

SELECT b.Name as ComponentName,CONVERT(DATETIME,a.PayrollDate) as PayrollMonth,isnull(b.AliasName,'''') ResourceData,a.* 
,ROW_NUMBER() OVER (PARTITION BY Type ORDER BY Type) AS Serial
FROM COM_CC50054 a WITH(NOLOCK) 
LEFT JOIN COM_CC50052 b WITH(NOLOCK) on b.NodeID=a.ComponentID
WHERE a.GradeID=@Grade AND PayrollDate=(Select Max(PayrollDate) From COM_CC50054  WITH(NOLOCK) 
Where CONVERT(DATETIME,PAYROLLDATE)<= CONVERT(DATETIME,''01-Aug-2025'') AND GradeID=@Grade)
Order By a.Type,a.SNo '
 ,20037
 ,1
