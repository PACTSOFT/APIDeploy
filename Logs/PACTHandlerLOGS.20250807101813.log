 'SELECT TOP 1 CONVERT(DATETIME,TD.DCALPHA1) REJOINDATE,CONVERT(DATETIME,TD.DCALPHA2) FROMDATE,CONVERT(DATETIME,TD.DCALPHA3) TODATE,DOCID,TD.DCAlpha22 OpeningBalance,TD.dcAlpha13 IsEncashRemainingDays,ISNULL(TD.dcAlpha14,0) EncashRemainingDays,CC.DCCCNID51,isnull(TD.DCALPHA16,''No'') IsEncash  FROM INV_DOCDETAILS ID WITH(NOLOCK) 
                                        JOIN COM_DOCTEXTDATA TD WITH(NOLOCK) ON ID.INVDOCDETAILSID=TD.INVDOCDETAILSID 
