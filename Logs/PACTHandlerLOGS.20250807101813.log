[System: 192.168.1.170] DEBUG | 08-07-2025 19:30:48.752 | General Service|:: CompanyIndex:53 SpName: spADM_GetDataSet 
 '
SELECT a.DocID,a.VoucherNo
FROM INV_DocDetails a WITH(NOLOCK) 
JOIN COM_DocCCData b WITH(NOLOCK) ON b.InvDocDetailsID=a.InvDocDetailsID
JOIN COM_DocTextData d WITH(NOLOCK) ON d.InvDocDetailsID=a.InvDocDetailsID
WHERE d.tDocumentType=67 and a.StatusID=369
AND ISDATE(d.dcAlpha1)=1 AND ISDATE(d.dcAlpha2)=1 AND ISDATE(d.dcAlpha3)=1  
AND a.DOCID<>0 AND b.dcCCNID51=20102 
--AND CONVERT(DATETIME,d.dcAlpha1)=CONVERT(DATETIME,''07/Aug/2025'')
