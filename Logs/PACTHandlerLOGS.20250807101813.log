 'DECLARE @From FLOAT,@To FLOAT
SET @From=CONVERT(FLOAT,CONVERT(DATETIME,''04 Jun 2015''))
SET @To=CONVERT(FLOAT,CONVERT(DATETIME,''07 Aug 2025''))

            SELECT distinct A.AccountCode,A.AccountName,ACC.Balance,A.AccountID,A.IsGroup,A.lft,A.rgt,A.AccountTypeID,A.Depth,A.PL IsSummary
FROM (SELECT AccountID,SUM(TR_Dr)-SUM(TR_Cr) Balance FROM (
--Transaction Dr
SELECT ACC.DebitAccount AccountID,ACC.VoucherNo,ACC.Amount TR_Dr,0 TR_Cr
FROM ACC_DocDetails ACC WITH(NOLOCK)
WHERE (((ACC.DocDate BETWEEN @From AND @To) AND ACC.DocumentType NOT IN (16,14,19)  AND (ACC.StatusID=369 or ACC.StatusID=429)) OR (ACC.DocDate<=@To AND (ACC.DocumentType=14 OR ACC.DocumentType=19) AND (ACC.StatusID=370 OR ACC.StatusID=439 OR ACC.StatusID=452)))
UNION ALL--Transaction Cr
SELECT ACC.CreditAccount AccountID,ACC.VoucherNo,0 TR_Dr,ACC.Amount TR_Cr
FROM ACC_DocDetails ACC WITH(NOLOCK)
WHERE (((ACC.DocDate BETWEEN @From AND @To) AND ACC.DocumentType NOT IN (16,14,19)  AND (ACC.StatusID=369 or ACC.StatusID=429)) OR (ACC.DocDate<=@To AND (ACC.DocumentType=14 OR ACC.DocumentType=19) AND (ACC.StatusID=370 OR ACC.StatusID=439 OR ACC.StatusID=452)))) AS T1  GROUP BY T1.AccountID
) AS ACC RIGHT JOIN ACC_Accounts A WITH(NOLOCK) ON A.AccountID=ACC.AccountID
WHERE A.AccountID>1 AND A.AccountTypeID IN (4,8,11,5,9,12) Order By lft'
 ,1
