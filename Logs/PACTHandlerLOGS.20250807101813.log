 ,'declare @AllowSession bit,@GUID nvarchar(50)
set @AllowSession=0
set @GUID=''ca01fc19-3434-4c5d-be0b-4cc2f824c15b''
if exists(select [GUID] from ADM_Login with(nolock) where [GUID]=@GUID)
