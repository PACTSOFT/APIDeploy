SELECT a.NodeID as EmpSeqNo,a.*,CONVERT(DATETIME,a.DOJ) CDOJ,CONVERT(DATETIME,a.DOB) CDOB,CONVERT(DATETIME,a.DOConfirmation) CDOC,CONVERT(DATETIME,a.DORelieve) CDORelieve,
ISNULL(ET.Name,'''') as sEmpType,ISNULL(N.Name,'''') as sNationality,ISNULL(R.Name,'''') as sReligion,
ISNULL(G.Name,'''') as sGender,ISNULL(MS.Name,'''') as sMaritalStatus

