 'SELECT QuotationID,UnitID,CONVERT(datetime, StartDate) as StartDate,CONVERT(datetime, EndDate) as EndDate from REN_Quotation with(nolock)                      
				WHERE ( ''01/Jan/2035''   between CONVERT(datetime, StartDate) and CONVERT(datetime, EndDate)      
