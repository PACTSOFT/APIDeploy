[System: 192.168.1.170] DEBUG | 08-07-2025 19:48:18.094 | General Service|:: CompanyIndex:134 SpName: spADM_GetDataSet 
 'DECLARE @GRADE INT,@GRADEWISEVACATIONPREF VARCHAR(5)

                        SELECT @GradewiseVacationPref=ISNULL(VALUE,''False'') FROM ADM_GlobalPreferences WITH(NOLOCK) WHERE NAME=''GradeWiseVacation''
                        IF (@GRADEWISEVACATIONPREF=''True'')
                        BEGIN
                             IF((SELECT COUNT(*) FROM ADM_CostCenterDef WITH(NOLOCK) WHERE CostCenterID=50051 and SysColumnName =''CCNID53'' and IsColumnInUse=1 and UserProbableValues=''H'')>0)
                                 SELECT @GRADE=ISNULL(HistoryNodeID,0) FROM COM_HistoryDetails WITH(NOLOCK) WHERE NodeID=1100 AND CostCenterID=50051 AND HistoryCCID=50053 AND (CONVERT(DATETIME,FromDate)<=CONVERT(DATETIME,''01/Jul/2025'')) AND (CONVERT(DATETIME,ToDate)>=CONVERT(DATETIME,''01/Jul/2025'') OR ToDate IS NULL)
                             ELSE
                                 SELECT @GRADE=ISNULL(CCNID53,0) FROM COM_CCCCDATA WITH(NOLOCK) WHERE COSTCENTERID=50051 AND NODEID=1100
                        END

                        IF ISNULL(@GRADE,0)=0
                             SET @GRADE=1

                        SELECT * FROM INV_DocDetails I WITH(NOLOCK)
                        JOIN COM_DocCCData CC WITH(NOLOCK) ON CC.InvDocDetailsID=I.InvDocDetailsID
                        JOIN COM_DocTextData T WITH(NOLOCK) ON T.InvDocDetailsID=I.InvDocDetailsID
                        WHERE T.tCostCenterID=40061 AND I.StatusID=369 AND CC.DCCCNID53=@GRADE
                        AND ISNULL(T.dcAlpha20,''No'')=''Yes'''
 ,1
 ,1
