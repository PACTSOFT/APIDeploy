                                        AND ISDATE(TD.DCALPHA1)=1 AND ISDATE(TD.DCALPHA2)=1 AND ISDATE(TD.DCALPHA3)=1
                                        AND (CONVERT(DATETIME,TD.DCALPHA3)<CONVERT(DATETIME,''21/Jul/2025'')
                                        OR (CONVERT(DATETIME,''21/Jul/2025'') BETWEEN CONVERT(DATETIME,TD.DCALPHA1) AND CONVERT(DATETIME,TD.DCALPHA3)))
                                        ORDER BY CONVERT(DATETIME,dcAlpha1) DESC'
