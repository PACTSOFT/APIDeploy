DECLARE @CNT INT,@I INT,@NODEID BIGINT,@TDATYPE NVARCHAR(100),@StartTime NVARCHAR(100),@EndTime NVARCHAR(100)
DECLARE @TAB TABLE(ID INT IDENTITY(1,1) primary key,NODEID BIGINT,CODE NVARCHAR(MAX),NAME NVARCHAR(MAX),RELIEVE DATETIME)
DECLARE @TEMP TABLE(ID INT IDENTITY(1,1) primary key,NODEID BIGINT,CODE NVARCHAR(MAX),NAME NVARCHAR(MAX),DADATE DATETIME,DATYPE NVARCHAR(MAX),StartTime NVARCHAR(100),EndTime NVARCHAR(100))

SET @DT1=''01 Aug 2025''
SET @DT2=''31 Aug 2025''
SET @DocumentType=67

INSERT INTO @TAB
SELECT C51.NODEID,C51.CODE,C51.NAME,ISNULL(CONVERT(DATETIME,C51.DORelieve),''01-JAN-2050'') FROM 
COM_CC50051 C51 WITH(NOLOCK) 
--WHERE C51.CODE=''11519''
WHERE 1=1  AND C51.NODEID IN (7768,7769,7772)

SELECT @CNT=COUNT(*) FROM @TAB

SET @I=1

SELECT DCALPHA1,DCALPHA3,DCCCNID51 INTO #T1 FROM INV_DOCDETAILS ID WITH(NOLOCK)
JOIN COM_DOCCCDATA CC WITH(NOLOCK) ON CC.INVDOCDETAILSID=ID.INVDOCDETAILSID 
JOIN COM_DOCTEXTDATA TD WITH(NOLOCK) ON TD.INVDOCDETAILSID=ID.INVDOCDETAILSID  
WHERE ID.DocumentType=67 AND ID.STATUSID NOT IN (372,376)  and dcCCNID51 in (select NodeID from @TAB)

SELECT TD.DCALPHA1,TD.DCALPHA2,TD.DCALPHA3,TD.dcAlpha4,ID.STATUSID,DCCCNID51,dcAlpha35,dcAlpha37,dcAlpha39 INTO #T5 FROM INV_DOCDETAILS ID WITH(NOLOCK)
JOIN COM_DOCCCDATA CC WITH(NOLOCK) ON CC.INVDOCDETAILSID=ID.INVDOCDETAILSID 
JOIN COM_DOCTEXTDATA TD WITH(NOLOCK) ON TD.INVDOCDETAILSID=ID.INVDOCDETAILSID  
WHERE ID.DocumentType=89 AND ID.STATUSID NOT IN (372,376) and dcCCNID51 in (select NodeID from @TAB)


SELECT  CONVERT(DATETIME,dcAlpha4) dcAlpha4,
case when dcAlpha15 is not null AND CONVERT(DATETIME,dcAlpha15)<=CONVERT(DATETIME,dcAlpha5) THEN DATEADD(D,-1,CONVERT(DATETIME,dcAlpha15)) ELSE
CONVERT(DATETIME,dcAlpha5) END dcAlpha5,
B.dcCCNID51,D.dcAlpha6 SESS INTO #T2
FROM INV_DocDetails a WITH(NOLOCK) 
JOIN COM_DocCCData b WITH(NOLOCK) ON b.InvDocDetailsID=a.InvDocDetailsID
JOIN COM_DocTextData d WITH(NOLOCK) ON d.InvDocDetailsID=a.InvDocDetailsID
WHERE a.DocumentType=62 and a.StatusID=369 AND LEN(dcAlpha4)=11 AND LEN(dcAlpha5)=11 AND ISDATE(ISNULL(dcAlpha4,''''))=1 AND ISDATE(ISNULL(dcAlpha5,''''))=1  and dcCCNID51 in (select NodeID from @TAB)

SELECT CONVERT(DATETIME,dcAlpha2) dcAlpha2,
case when dcAlpha1 is not null AND CONVERT(DATETIME,dcAlpha1)<=CONVERT(DATETIME,dcAlpha3) THEN DATEADD(D,-1,CONVERT(DATETIME,dcAlpha1)) ELSE CONVERT(DATETIME,dcAlpha3) END dcAlpha3,
B.dcCCNID51, D.dcAlpha28 SESV INTO #T3
FROM INV_DocDetails a  WITH(NOLOCK) 
JOIN COM_DocCCData b WITH(NOLOCK) ON b.InvDocDetailsID=a.InvDocDetailsID
JOIN COM_DocTextData d WITH(NOLOCK) ON d.InvDocDetailsID=a.InvDocDetailsID
WHERE a.CostCenterID=40072 and a.StatusID=369 AND LEN(dcAlpha2)=11 AND LEN(dcAlpha3)=11 AND ISDATE(ISNULL(dcAlpha2,''''))=1 AND ISDATE(ISNULL(dcAlpha3,''''))=1 and dcCCNID51 in (select NodeID from @TAB)



WHILE(@DT1<=@DT2)
BEGIN

SELECT @CNT=COUNT(id) FROM @TAB
SET @I=1

WHILE(@I<=@CNT)
BEGIN

SELECT @NODEID=NODEID,@RELIEVE=RELIEVE FROM @TAB WHERE ID=@I

INSERT INTO @TEMP
SELECT NODEID,CODE,NAME,@DT1,'''','''','''' FROM @TAB WHERE ID=@I

IF(@RELIEVE<@DT1)
BEGIN
SET @I=@I+1
CONTINUE
END


IF EXISTS( SELECT * FROM #T1 WITH(NOLOCK)  WHERE DCCCNID51=@NODEID AND 
(ISDATE(DCALPHA1)=1 AND CONVERT(DATETIME,DCALPHA1)=CONVERT(DATETIME,@DT1)) AND @DocumentType=67) -- DA
BEGIN

		UPDATE @TEMP SET DATYPE=''P'' WHERE NODEID=@NODEID AND DADATE=@DT1
		
		IF EXISTS(  SELECT * FROM #T2 WITH(NOLOCK) WHERE dcCCNID51=@NODEID AND @DT1 BETWEEN CONVERT(DATETIME,dcAlpha4)AND CONVERT(DATETIME,dcAlpha5))
		BEGIN
			IF EXISTS(SELECT * FROM #T2 WITH(NOLOCK) WHERE dcCCNID51=@NODEID AND @DT1 BETWEEN CONVERT(DATETIME,dcAlpha4)AND CONVERT(DATETIME,dcAlpha5) AND SESS=''SESSION1'')
				UPDATE @TEMP SET DATYPE=''L/P'' WHERE NODEID=@NODEID AND DADATE=@DT1
				ELSE
				UPDATE @TEMP SET DATYPE=''P/L'' WHERE NODEID=@NODEID AND DADATE=@DT1
		END
		else IF EXISTS(  SELECT * FROM #T3 WITH(NOLOCK) WHERE dcCCNID51=@NODEID AND @DT1 BETWEEN CONVERT(DATETIME,dcAlpha2)AND CONVERT(DATETIME,dcAlpha3))
		BEGIN
			IF EXISTS(SELECT * FROM #T3 WITH(NOLOCK) WHERE dcCCNID51=@NODEID AND @DT1 BETWEEN CONVERT(DATETIME,dcAlpha2)AND CONVERT(DATETIME,dcAlpha3) AND SESV=''SESSION1'')
				UPDATE @TEMP SET DATYPE=''V/P'' WHERE NODEID=@NODEID AND DADATE=@DT1
				ELSE
				UPDATE @TEMP SET DATYPE=''P/V'' WHERE NODEID=@NODEID AND DADATE=@DT1

		END	
		
END
ELSE IF EXISTS( SELECT * FROM #T5 WITH(NOLOCK)  WHERE DCCCNID51=@NODEID AND 
(ISDATE(DCALPHA1)=1 AND CONVERT(DATETIME,DCALPHA1)=CONVERT(DATETIME,@DT1)) and  @DocumentType=89) --Attendance
BEGIN

IF EXISTS(SELECT * FROM #T5 WITH(NOLOCK) WHERE DCCCNID51=@NODEID AND ISNULL(DCALPHA1,'''')<>'''' AND ISNULL(DCALPHA3,'''')<>'''' AND
	 ISDATE(dcAlpha39)=1 AND CONVERT(DATETIME,dcAlpha39)=CONVERT(DATETIME,@DT1) AND DCALPHA2!=DCALPHA4 AND STATUSID=369)
	BEGIN
		UPDATE @TEMP SET DATYPE=''P'',StartTime=@StartTime,EndTime=@EndTime WHERE NODEID=@NODEID AND DADATE=@DT1
	END

	ELSE IF EXISTS(SELECT * FROM #T5 WITH(NOLOCK) WHERE DCCCNID51=@NODEID AND ISNULL(DCALPHA1,'''')<>'''' AND ISNULL(DCALPHA3,'''')<>'''' AND
	 ISDATE(dcAlpha39)=1 AND CONVERT(DATETIME,dcAlpha39)=CONVERT(DATETIME,@DT1) AND STATUSID=371 AND (ISNULL(dcAlpha35,'''')<>'''' OR ISNULL(dcAlpha37,'''')<>'''') )
	BEGIN
		UPDATE @TEMP SET DATYPE=''R'',StartTime=@StartTime,EndTime=@EndTime WHERE NODEID=@NODEID AND DADATE=@DT1
	END
	ELSE IF EXISTS(SELECT * FROM #T5 WITH(NOLOCK) WHERE DCCCNID51=@NODEID AND  ISDATE(dcAlpha39)=1 AND CONVERT(DATETIME,dcAlpha39)=CONVERT(DATETIME,@DT1) AND
	((ISNULL(DCALPHA2,'''')<>'''')
	OR
	(ISNULL(DCALPHA3,'''')<>'''')
	) AND STATUSID=369)
	BEGIN
		UPDATE @TEMP SET DATYPE=''S'',StartTime=@StartTime,EndTime=@EndTime WHERE NODEID=@NODEID AND DADATE=@DT1
	END
END

ELSE IF EXISTS(  SELECT * FROM #T2 WITH(NOLOCK) WHERE dcCCNID51=@NODEID AND @DT1 BETWEEN CONVERT(DATETIME,dcAlpha4)AND CONVERT(DATETIME,dcAlpha5))
BEGIN
	UPDATE @TEMP SET DATYPE=''L'' WHERE NODEID=@NODEID AND DADATE=@DT1
END

ELSE IF EXISTS(  SELECT * FROM #T3 WITH(NOLOCK) WHERE dcCCNID51=@NODEID AND @DT1 BETWEEN CONVERT(DATETIME,dcAlpha2) AND CONVERT(DATETIME,dcAlpha3))
BEGIN
	UPDATE @TEMP SET DATYPE=''V'' WHERE NODEID=@NODEID AND DADATE=@DT1		
END	

ELSE
BEGIN
	EXEC spPAY_GetWeeklyOffHoliDay @DT1,@NODEID,1,1,@TDATYPE OUTPUT

	IF(ISNULL(@TDATYPE,'''')<>'''')
		UPDATE @TEMP SET DATYPE=@TDATYPE WHERE NODEID=@NODEID AND DADATE=@DT1
	ELSE IF(@DT1<=GETDATE())
		UPDATE @TEMP SET DATYPE=''A'' WHERE NODEID=@NODEID AND DADATE=@DT1
END

SET @I=@I+1
END

SET @DT1=DATEADD(D,1,@DT1)
END



SELECT L.name Location,T.DATYPE AttendanceType,count(T.Name) EmpCount,T.DADATE  FROM @TEMP T
LEFT JOIN COM_CCCCData C WITH(NOLOCK) ON C.NodeID=T.NODEID AND C.CostCenterID=50051
JOIN COM_Location L WITH(NOLOCK) ON L.NODEID=C.CCNID2
join COM_department c3 with(nolock) on C.CCNID4=c3.nodeid
join COM_CC50069 c4 with(nolock) on C.CCNID69=c4.nodeid
join COM_CC50053 c5 with(nolock) on C.CCNID53=c5.nodeid
group by L.name,T.DADATE,T.DATYPE
order by L.name,T.DADATE

DROP TABLE #T1
DROP TABLE #T2
DROP TABLE #T3
DROP TABLE #T5'
